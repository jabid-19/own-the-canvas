{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/components/**/*.ts", "src/components/**/*.tsx", "src/hooks/**/*.ts", "src/runtime/**/*.ts", "src/runtime/**/*.tsx", "src/types/**/*.ts", "src/index.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx"]
}
